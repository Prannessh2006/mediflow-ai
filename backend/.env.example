# MediFlow AI — Environment Variables
# Copy this to .env and fill in your values

# ── AI Services ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# ── Vector Database ───────────────────────────────────────────────────────────
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX=mediflow

# ── Database ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Server Config ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Notes ─────────────────────────────────────────────────────────────────────
# Without these keys, the app runs in DEMO MODE with:
# - In-memory mock database (data resets on restart)
# - Keyword-based AI classification (no Gemini calls)
# - Local knowledge base for RAG (no Pinecone queries)
# Everything works and looks real — just swap in keys for production!
